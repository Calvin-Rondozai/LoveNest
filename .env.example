# Mobile app configuration. Copy to .env (never commit .env).
# EXPO_PUBLIC_* values are bundled into the app and are not secret.

# LoveNest API address.
#   Android emulator talking to your PC:  http://10.0.2.2:3000
#   Phone on the same Wi-Fi as your PC:    http://<your PC's IP>:3000   (run: ipconfig)
#   Production:                            https://lovenest-api.onrender.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Google sign-in: the OAuth "Web application" client ID (same as GOOGLE_CLIENT_ID on the server)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Build settings (used by app.config.js)
ANDROID_PACKAGE=
IOS_BUNDLE_ID=
GOOGLE_IOS_URL_SCHEME=
