# Copy to .env and fill in. Never commit .env.
# Settings marked "Stage N" can stay empty until that stage.

NODE_ENV=development
PORT=3000

# Stage 1: database
# Local development: a SQLite file (no account needed).
DATABASE_URL=file:./data/local.db
# Production (Stage 6): your Turso database URL and token, e.g.
# DATABASE_URL=libsql://lovenest-yourname.turso.io
# DATABASE_AUTH_TOKEN=eyJ...
DATABASE_AUTH_TOKEN=

# Stage 1: Better Auth
# At least 32 random characters. Generate with:  npx auth secret
BETTER_AUTH_SECRET=
# Public URL of this server (Render URL in production)
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated web origins allowed to use the API with cookies (the admin dashboard)
ADMIN_ORIGINS=http://localhost:8080
# Deep-link scheme of the mobile app (must match "scheme" in the app's app.json)
APP_SCHEME=lovenest
# Current Terms/Privacy version (LEGAL_VERSION in the app's src/legal/content.ts)
LEGAL_VERSION=2026-10-09
# Delivery fee is tiered in code: under US$50 → US$5; US$50+ → US$10.

# First admin account, created by: npm run db:seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=LoveNest Admin

# Email (Resend). Empty in development = codes print in the terminal.
RESEND_API_KEY=
EMAIL_FROM=LoveNest <onboarding@resend.dev>

# Product photos (Cloudinary). Leave empty to store photos in the database (recommended in Zimbabwe).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stage 4: payments (Paynow, Receive Payments, Integrations)
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
# In Paynow test mode, mobile payments must use your merchant account email
PAYNOW_AUTH_EMAIL=
