{
  "name": "lovenest-server",
  "version": "0.1.0",
  "private": true,
  "description": "LoveNest API: auth, products, orders and payments",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.6 <21"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "auth:schema": "node --env-file=.env --import ./scripts/node20-polyfills.mjs ./node_modules/auth/dist/index.mjs generate --config src/auth.ts --output src/db/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=.env src/db/seed.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@better-auth/expo": "^1.7.7",
    "@hono/node-server": "^2.1.4",
    "@libsql/client": "^0.18.0",
    "better-auth": "^1.7.7",
    "cloudinary": "^2.11.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "paynow": "^2.2.2",
    "resend": "^6.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "auth": "^1.7.7",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
